<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>flunet</AssemblyName>
    <RootNamespace>FluNET.Cli</RootNamespace>
    <IsPackable>false</IsPackable>
    <Description>Compatibility FluNET CLI. New tooling is provided by FluNET.Tool.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluNET.Engine\FluNET.Engine.csproj" />
  </ItemGroup>

</Project>
